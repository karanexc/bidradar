# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your site address (used for Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe → Developers → API keys (use test keys until launch)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# The agent backend, so onboarding can trigger a first run
AGENT_URL=http://localhost:8000
CRON_SECRET=same-value-as-agent
