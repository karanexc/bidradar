# Copy this file to .env and fill in your values. Never commit .env.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret between the website, GitHub Actions and this agent.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=change-me

# AI models, written as "provider:model".
# Paid (Anthropic):  anthropic:claude-haiku-5-5  /  anthropic:claude-sonnet-5-5
# Free, local:       ollama:llama3.1   (needs Ollama running and langchain-ollama installed)
LLM_MODEL=anthropic:claude-haiku-5-5
DRAFT_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Scores are 0-100. Tenders below MATCH_THRESHOLD are dropped;
# tenders at or above DRAFT_THRESHOLD get a first-draft response.
MATCH_THRESHOLD=65
DRAFT_THRESHOLD=80
MAX_CANDIDATES_PER_USER=25

# Optional: daily email digests via Resend (free tier available)
RESEND_API_KEY=
DIGEST_FROM=BidRadar <alerts@yourdomain.com>
APP_URL=http://localhost:3000
